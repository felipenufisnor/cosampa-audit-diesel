# LLM provider config (OpenAI-compatible API). Trocar livremente:
#   - openrouter:  https://openrouter.ai/api/v1
#   - togetherai:  https://api.together.xyz/v1
#   - groq:        https://api.groq.com/openai/v1
#   - ollama:      http://localhost:11434/v1   (sem chave)
#   - vllm:        http://localhost:8001/v1    (sem chave)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b
LLM_FALLBACK_MODEL=deepseek/deepseek-chat

LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# Execucao padrao para assistente real:
#   AUDIT_AI_OFFLINE=0
#   DEMO_MODE=off
#   LLM_API_KEY=<chave do provider>
# Sem chave, o backend sinaliza assistant_status=missing_key e desabilita
# perguntas livres, mantendo caches locais quando existirem.
AUDIT_AI_OFFLINE=0
DEMO_MODE=off

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
